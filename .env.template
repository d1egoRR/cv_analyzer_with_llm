# ==============================================================================
# CV Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# .env is ignored by Git to protect sensitive API keys.

# ------------------------------------------------------------------------------
# Primary Provider: Google Gemini
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
ENABLE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Backup Provider: OpenAI (Disabled by default to protect paid credits)
# ------------------------------------------------------------------------------
ENABLE_OPENAI=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Future Providers (Reserved for upcoming fallback stages)
# ------------------------------------------------------------------------------
# Groq (Ultra-fast inference with open-weights models)
# Get API key at: https://console.groq.com/
ENABLE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# OpenRouter (Aggregated free/paid models)
# Get API key at: https://openrouter.ai/
ENABLE_OPENROUTER=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# Mistral AI
# Get API key at: https://console.mistral.ai/
ENABLE_MISTRAL=false
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest

# ------------------------------------------------------------------------------
# Resilience Settings
# ------------------------------------------------------------------------------
# Maximum seconds to wait per LLM request attempt before timing out
LLM_TIMEOUT_SECONDS=30.0
